{
  "name": "almond",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @almond/acp && npm run build -w @almond/runtime && npm run build -w @almond/stdio && npm run build -w @almond/backend-claude-agent-sdk && npm run build -w @almond/cli",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.4.0"
  },
  "dependencies": {
    "zod": "^4.0.0"
  }
}
